#!/bin/sh
# 릴리스 태그(v*)를 올릴 때만 봐요: 태그가 가리키는 커밋의 내용이 실기기까지 포함한 npm run verify 를 통과했는지.
# 브랜치 푸시는 막지 않아요(그건 GitHub Actions 가 봐요). 태그 삭제도 그냥 보내요.
# 기록은 scripts/verify.mjs 가 전체 검증을 통과할 때마다 공용 git 디렉터리의 jari-device-verified 에 쌓아요.
list="$(git rev-parse --git-common-dir)/jari-device-verified"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/v*) ;;
    *) continue ;;
  esac
  [ "$local_sha" = "$zero" ] && continue
  tree="$(git rev-parse "$local_sha^{tree}")"
  if [ -f "$list" ] && grep -q "^$tree " "$list"; then
    continue
  fi
  cat >&2 <<MSG
릴리스 태그 ${remote_ref#refs/tags/} 는 실기기 검증을 통과한 커밋에만 붙일 수 있어요.
  태그의 커밋 내용(트리 $tree)이 실기기 포함 npm run verify 기록에 없어요.
  그 커밋의 내용을 스테이징한 채로 npm run verify(폰 연결·잠금 해제)를 돌리고 다시 푸시해 주세요.
  폰이 여러 대면 ANDROID_SERIAL=<serial> npm run verify
MSG
  status=1
done
exit $status

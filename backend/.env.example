# Local CLI only: uv run --env-file .env --frozen python -m korail_bot.mobile ...
MOBILE_SECRET_FILE=.secrets/mobile.key
MOBILE_DATA_DIR=.data/jari
MOBILE_REDIS_URL=redis://127.0.0.1:6379/0
MOBILE_ORIGINS=https://localhost,capacitor://localhost
# Optional, never commit the actual credential file:
# MOBILE_FCM_CREDENTIALS=/secure/path/firebase-service-account.json
